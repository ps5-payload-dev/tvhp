/*
 * Connect screen: the saved-server list, the add/edit dialog, and the
 * form field and button styles they share.
 */

/* ------------------------------------------------------------------ */
/* Connect screen                                                     */
/* ------------------------------------------------------------------ */

#connect-view {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	width: 100%;
	height: 100%;
}

#servers {
	width: 900px;
	height: 720px;
}

.server-row {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 96px;
	margin-bottom: 12px;
	margin-right: 12px;
	padding: 0px 24px;
	background-color: #ffffff06;
	border-left: 6px #ffffff00;
	cursor: pointer;
}

.server-row:hover {
	background-color: #ffffff0c;
}

.srvinfo {
	display: block;
	flex: 1;
	overflow: hidden;
}

.srvname {
	display: block;
	font-size: 30px;
	font-weight: bold;
	color: #e8edf7;
	white-space: nowrap;
	overflow: hidden;
}

.srvdetail {
	display: block;
	margin-top: 4px;
	font-size: 21px;
	color: #8593ab;
	white-space: nowrap;
	overflow: hidden;
}

.server-row.add .srvname {
	color: #8593ab;
}

.server-row.selected {
	background-color: #1a2336;
	border-left: 6px #ffffff34;
}

#servers.active .server-row.selected {
	background-color: #232f47;
	border-left: 6px #f5b453;
}

#servers.active .server-row.selected .srvname {
	color: #ffffff;
}

/* Shown in place of the rows when nothing has been added yet. */
.empty {
	display: block;
	padding: 40px 24px;
	font-size: 26px;
	color: #8593ab;
	text-align: center;
}

/* ------------------------------------------------------------------ */
/* Add / edit server dialog (Options button)                           */
/* ------------------------------------------------------------------ */

#server-dialog {
	position: absolute;
	top: 0px;
	left: 0px;
	width: 100%;
	height: 100%;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	background-color: #060a14d9;
	z-index: 20;
}

.dialog-card {
	box-sizing: border-box;
	width: 720px;
	padding: 44px 52px;
	background-color: #141b2b;
	border: 2px #ffffff1f;
}

.dialog-title {
	display: block;
	margin-bottom: 30px;
	font-size: 40px;
	font-weight: bold;
	color: #ffffff;
}

.dialog-hints {
	display: block;
	margin-top: 28px;
	text-align: center;
}

.dialog-hints .key-icon {
	width: 40px;
	height: 40px;
	margin-left: 18px;
}

.dialog-hints .hint {
	margin-left: 8px;
	font-size: 21px;
	color: #8593ab;
	vertical-align: middle;
}

.field {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 24px;
}

.field .label {
	box-sizing: border-box;
	display: block;
	width: 200px;
	margin-right: 20px;
	padding: 8px 12px;
	font-size: 19px;
	font-weight: bold;
	letter-spacing: 3px;
	color: #8593ab;
	border: 2px #ffffff00;
	tab-index: auto;
}

.field .label:focus {
	color: #f5b453;
	border: 2px #f5b453;
	background-color: #ffffff0a;
}

input.text, input.password {
	box-sizing: border-box;
	display: block;
	width: auto;
	flex: 1;
	padding: 16px 20px;
	font-size: 28px;
	color: #e8edf7;
	background-color: #ffffff0a;
	border: 2px #ffffff1c;
	tab-index: auto;
	caret-color: #f5b453;
}

input.text:focus, input.password:focus {
	border: 2px #f5b453;
	background-color: #ffffff12;
}

button {
	box-sizing: border-box;
	display: block;
	width: 100%;
	margin-top: 12px;
	padding: 18px 0px;
	font-size: 28px;
	font-weight: bold;
	letter-spacing: 2px;
	text-align: center;
	color: #171006;
	background-color: #d99a3f;
	border: 2px #d99a3f;
	tab-index: auto;
	cursor: pointer;
}

button:focus, button:hover {
	background-color: #f5b453;
	border: 2px #ffd28a;
}

.dialog-buttons {
	display: block;
	margin-top: 12px;
}

.dialog-buttons button {
	display: inline-block;
	width: 48%;
	margin-top: 0px;
}

.dialog-buttons #btn-save {
	margin-right: 4%;
}

button span {
	display: inline;
}

#servers .status,
.dialog-card .status {
	display: block;
	margin-top: 20px;
	font-size: 23px;
	text-align: center;
	color: #ff8f6e;
}

.connect-hints {
	display: flex;
	align-items: center;
	margin-top: 36px;
}
